{
  "name": "patrol",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host localhost",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host localhost --port 3000 --strictPort",
    "test": "node --import tsx --test src/game/*.test.ts",
    "prepare:maps": "node --import tsx scripts/prepare-maps.ts",
    "prepare:setups": "node --import tsx scripts/prepare-setups.ts",
    "prepare:tutorial": "node --import tsx scripts/prepare-tutorial.ts",
    "prepare:campaign": "node --import tsx scripts/prepare-campaign.ts && node --import tsx scripts/prepare-usa-campaign.ts",
    "prepare:usa": "node --import tsx scripts/prepare-usa-campaign.ts",
    "test:rules": "node --import tsx --test scripts/firestore-rules.test.ts",
    "test:saves": "node --import tsx --test scripts/firestore-progress.test.ts"
  },
  "dependencies": {
    "firebase": "12.6.0",
    "maplibre-gl": "6.14.0",
    "posthog-js": "^1.438.12"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.0.0",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  },
  "overrides": {
    "@firebase/app": "0.14.6",
    "@grpc/grpc-js": "1.14.6"
  }
}
